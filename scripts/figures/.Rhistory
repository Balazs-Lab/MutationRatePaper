################################################################################
# Data Analysis for Figure 3 Plots:
# MRA Analysis
################################################################################
# Load libraries
library(readr)
library(dplyr)
library(ggplot2)
library(readxl)
library(tidyr)
library(tidyverse)
# Set Directory
# setwd("~/")
setwd("~/Bioinformatics/ERR-Seq_2/MutRatePaper/scripts/figures")
################################################################################
## Load MRA Data
################################################################################
path_to_MRA = "../../data/models/mra/production/FINAL_mutation_supply_dataset.csv"
df <- read_csv(path_to_MRA)
################################################################################
## Extended Figure 3B - observed vs. posterior predictive check (PPC) predicted mutation counts by mutation type
################################################################################
ppc_data <- read_csv("../../data/models/mra/production/postfit_ppc_by_mutation_type.csv")
# select mut_type, obs_wt, pred_wt, and wt_ppc_ratio
ppc_data <- ppc_data %>%
dplyr::select(mut_type, obs_wt, pred_wt, wt_ppc_ratio)
# write to .csv
write_csv(ppc_data, "../../figures/extended3/3B-ppc_by_mutation_type.csv")
# print the mean wt_ppc_ratio across mutaiton type
mean(ppc_data$wt_ppc_ratio, na.rm = TRUE)
################################################################################
## Figure 3A - Sliding Window Analysis - Observed Counts vs Full MRA
## Windows are computed independently within each coverage segment, then combined
################################################################################
window_size = 249
step_size = 24
left_break = 4286   # first position of the middle (high-coverage) segment
right_break = 4769  # last position of the middle segment
segments <- tribble(
~segment, ~seg_start,      ~seg_end,
"left",   1,               left_break - 1,
"middle", left_break,      right_break,
"right",  right_break + 1, max(df$ref_position, na.rm = TRUE)
)
# Generic: run any per-window summarizer within one segment
sliding_window_one_segment <- function(segment, seg_start, seg_end, data, summarize_fn) {
if (seg_end - seg_start + 1 < window_size) {
stop("Segment '", segment, "' is shorter than window_size")
}
seg_data <- data %>%
filter(ref_position >= seg_start, ref_position <= seg_end)
windows <- tibble(
window_start = seq(seg_start, seg_end - window_size + 1, by = step_size)
) %>%
mutate(
window_end = window_start + window_size - 1,
window_mid = (window_start + window_end) / 2
)
pmap_dfr(
list(windows$window_start, windows$window_end, windows$window_mid),
summarize_fn,
data = seg_data
) %>%
mutate(segment = segment, .before = 1)
}
# Run a summarizer across all segments and concatenate
sliding_window_by_segment <- function(data, summarize_fn) {
pmap_dfr(segments, sliding_window_one_segment, data = data, summarize_fn = summarize_fn) %>%
mutate(segment = factor(segment, levels = segments$segment))
}
summarize_one_window <- function(start, end, mid, data) {
data %>%
filter(ref_position >= start, ref_position <= end) %>%
summarise(
window_start = start,
window_end = end,
window_mid = mid,
MRA_per_position = mean(bio_rate_median, na.rm = TRUE),
Observed_per_position = sum(wt_count) / sum(wt_coverage)
)
}
sliding_window_results <- sliding_window_by_segment(df, summarize_one_window)
cor.test(sliding_window_results$MRA_per_position, sliding_window_results$Observed_per_position, method = "pearson")
# write to .csv
write_csv(sliding_window_results, "../../figures/figure3/3-sliding_window_results-pooled.csv")
################################################################################
## Figure 3A/B - Sliding Window Analysis - MRA mutation types
################################################################################
# perform sliding window analysis for G->A, nonG->A, Insertions, and Deletions
# 1 - assign mutation classes
df_classed <- df %>%
mutate(
mutation_class = case_when(
mut_type == "G->A" ~ "G_to_A",
mut_type %in% c("insertion") ~ "insertion",
mut_type %in% c("deletion") ~ "deletion",
str_detect(mut_type, "->") & mut_type != "G->A" ~ "nonG_to_A_substitution",
TRUE ~ NA_character_
)
) %>%
filter(!is.na(mutation_class))
rate_column <- "bio_rate_median"
# take the mean of the various substitions at each site
position_class_rates <- df_classed %>%
group_by(ref_position, ref_nucleotide, mutation_class) %>%
summarise(
estimated_class_rate = mean(.data[[rate_column]], na.rm = TRUE),
wt_count = sum(wt_count, na.rm = TRUE),
wt_coverage = sum(wt_coverage, na.rm = TRUE),
n_mutation_types_in_class = n(),
.groups = "drop"
)
summarize_one_window_type <- function(start, end, mid, data) {
data %>%
filter(ref_position >= start, ref_position <= end) %>%
group_by(mutation_class) %>%
summarise(
window_start = start,
window_end = end,
window_mid = mid,
MRA_estiamte = mean(estimated_class_rate, na.rm = TRUE),
Observed_per_position = sum(wt_count) / sum(wt_coverage),
.groups = "drop"
)
}
sliding_window_results_type <- sliding_window_by_segment(position_class_rates, summarize_one_window_type)
# melt the data for plotting - one row per window, one column per class/metric
sliding_window_melted <- sliding_window_results_type %>%
select(segment, window_start, window_end, window_mid, mutation_class, MRA_estiamte, Observed_per_position) %>%
pivot_wider(
names_from = mutation_class,
values_from = c(MRA_estiamte, Observed_per_position)
)
# save to csv
write_csv(sliding_window_melted, "../../figures/figure3/3-sliding_window_results-subclass.csv")
# create a table and save the correlation output data
all <- cor.test(sliding_window_results$MRA_per_position, sliding_window_results$Observed_per_position, method = "pearson")
GA  <- cor.test(sliding_window_melted$MRA_estiamte_G_to_A, sliding_window_melted$Observed_per_position_G_to_A, method = "pearson")
nGA <- cor.test(sliding_window_melted$MRA_estiamte_nonG_to_A_substitution, sliding_window_melted$Observed_per_position_nonG_to_A_substitution, method = "pearson")
IN  <- cor.test(sliding_window_melted$MRA_estiamte_insertion, sliding_window_melted$Observed_per_position_insertion, method = "pearson")
DEL <- cor.test(sliding_window_melted$MRA_estiamte_deletion, sliding_window_melted$Observed_per_position_deletion, method = "pearson")
# add data to table
cor_test_table <- tibble(
mutation_class = c("all", "G->A", "nonG->A", "insertion", "deletion"),
estimate = c(all$estimate, GA$estimate, nGA$estimate, IN$estimate, DEL$estimate),
p.value  = c(all$p.value,  GA$p.value,  nGA$p.value,  IN$p.value,  DEL$p.value)
)
cor_test_table
# write to csv
write_csv(cor_test_table, "../../figures/figure3/3-correlation_data.csv")
